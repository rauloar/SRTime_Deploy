# ── SRTime .gitignore ─────────────────────────────────────────
# El proyecto vive en attendance/. Todo lo demás es excluido.

# ── Carpetas externas al proyecto ─────────────────────────────
# Deployments, installers and local deployment scripts never belong in Git.
/deploy/
att/
backup/
build/
dist/
pyzk/
SRCopilot/

# ── Virtual Environments ─────────────────────────────────────
env/
venv/
ENV/
.venv/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
*.pot
*.spec
.pytest_cache/
.pytest-tmp-*/
.coverage
htmlcov/
.tox/

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Environment variables ────────────────────────────────────
# .env.* cubre .env.production, .env.staging, .env.development, etc.
# Solo la plantilla canónica se re-incluye; los perfiles de QA/deploy permanecen locales.
.env
.env.*
!.env.example

# ── Logs ──────────────────────────────────────────────────────
*.log

# ── Database files (local development) ───────────────────────
*.db
*.sqlite
*.sqlite3

# ── OS ────────────────────────────────────────────────────────
Thumbs.db
.DS_Store

# ── Backup and temporary files ───────────────────────────────
*.bak
*.tmp
_git_status.txt

# ── Credenciales y archivos sensibles locales ─────────────────
CREDENCIALES.txt
*.pem
*.key
*.crt

# ── Node.js / Next.js (frontend) ─────────────────────────────
attendance/web/node_modules/
attendance/web/.next/
attendance/web/out/
attendance/web/.cache/
.pnpm-store/

# ── Application logs directory ────────────────────────────────
attendance/logs/
attendance/nuitka-crash-report.xml

# ── Datos biométricos/reales de importación ───────────────────
# Usar exclusivamente attendance/tests/fixtures/tm_mr001_mock.txt en tests.
# Los archivos descargados de terminal, incluso los usados durante QA manual,
# permanecen locales para no publicar datos biométricos ni identificadores.
TM-MR001*.txt
TM-MR001*.Txt

# ── Legacy / generated docs ──────────────────────────────────
CLEANUP_EXECUTED.md
test_results.html
coverage.xml

# ── AI agent instruction files ────────────────────────────────
AGENTS.md
CLAUDE.md

# ── Frozen requirements (generado, no editar a mano) ─────────
attendance/requirements-frozen.txt

# ── Dumps y backups de base de datos ─────────────────────────
*.dump
*.sql.gz
*.pg_dump
