# ============================================================
# Legacy compatibility template. The active global configuration is
# config/.env (copy config/.env.example); do not create attendance/.env.
# ============================================================

# Database connection. Copy to .env only for a local non-production run.
DB_ENGINE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=__SET_DATABASE_USER__
DB_PASS=__SET_DATABASE_PASSWORD__
DB_NAME=srtime_db

# Generate a random value before running the application.
SECRET_KEY=__GENERATE_RANDOM_SECRET_KEY__
TERMINAL_CREDENTIAL_KEY=__GENERATE_RANDOM_TERMINAL_KEY__
TIMEZONE=America/Argentina/Buenos_Aires
