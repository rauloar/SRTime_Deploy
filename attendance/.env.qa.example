# Copiar como .env.qa para usar el instalador local de PostgreSQL.
# .env.qa está ignorado: nunca subir claves o contraseñas reales.
DB_ENGINE=postgres
DB_HOST=__SET_IN_WEB_INSTALLER__
DB_PORT=5432
DB_USER=postgres
DB_PASS=__SET_IN_WEB_INSTALLER__
DB_NAME=srtime_qa

SECRET_KEY=__GENERATED_ON_FIRST_START__
MIN_PASSWORD_LENGTH=8
SRTIME_DEFER_ADMIN_SETUP=true
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=60

API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=["http://localhost:8000"]
LOG_LEVEL=INFO
LOG_FORMAT=text
