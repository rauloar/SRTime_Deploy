# Garantiza line endings LF para scripts y configs que corren en Linux.
# Sin esto, un checkout en Windows podría dejar CRLF y romper el shebang
# (#!/usr/bin/env bash\r) al ejecutarse en el servidor.
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
.env.*example   text eol=lf
