[Unit]
Description=SRTime API (FastAPI + Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__/api
EnvironmentFile=__APP_DIR__/config/.env
ExecStart=__APP_DIR__/api/run_api \
    --workers 4 \
    --bind 127.0.0.1:8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
