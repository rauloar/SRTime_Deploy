# ============================================================
# SRTime — Variables de Entorno (Producción)
# ============================================================
# Archivo de configuración único del deploy.
# Ubicación canónica en el servidor: <APP_DIR>/config/.env
# El instalador genera este archivo con secretos aleatorios y lo deja
# con permisos 600. NO commitear un .env real con secretos.
#
# El binario lo lee de dos formas (lo que ocurra primero):
#   1. La variable de entorno SRTIME_ENV_FILE (la setea el systemd unit).
#   2. Un archivo .env junto al ejecutable.
# Además systemd lo inyecta como EnvironmentFile=, así que las variables
# ya están en el entorno del proceso.
# ============================================================

# ── Base de datos PostgreSQL ────────────────────────────────
DB_ENGINE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=srtime
DB_PASS=__GENERAR_PASSWORD_SEGURO__
DB_NAME=srtime_db

# ── JWT / Seguridad ─────────────────────────────────────────
# Generar con: openssl rand -hex 32
SECRET_KEY=__GENERAR_SECRET_KEY__
TERMINAL_CREDENTIAL_KEY=__GENERAR_TERMINAL_CREDENTIAL_KEY__
ACCESS_TOKEN_EXPIRE_MINUTES=60
MIN_PASSWORD_LENGTH=12
COOKIE_SECURE=true

# ── API (uvicorn) ───────────────────────────────────────────
# El reverse proxy (nginx) expone públicamente; la API escucha local.
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
# Comma-separated LAN client IPs that may run the initial setup wizard.
# Leave empty after bootstrap. Loopback is always allowed.
SRTIME_SETUP_ALLOWED_IPS=
SRTIME_WEB_DIR=__APP_DIR__/web
MAX_IMPORT_SIZE_BYTES=10485760

# ── CORS — orígenes permitidos (formato lista JSON) ─────────
# LAN:     ["https://srtime.intranet.example"]
# Dominio: ["https://srtime.tuempresa.com"]
CORS_ORIGINS=["http://localhost"]

# El frontend usa rutas same-origin (/api/...) y FastAPI sirve el export estático.
# NEXT_PUBLIC_API_URL debe quedar vacío salvo desarrollo desacoplado.
NEXT_PUBLIC_API_URL=

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/var/log/srtime
LOG_APP_FILE=api.log
LOG_ERROR_FILE=api-error.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
