# SRTime global configuration. Copy to config/.env; never commit the local file.
# Network / routing: 0.0.0.0 accepts loopback and private LAN connections.
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
SRTIME_SETUP_ALLOWED_IPS=private

# Capacidades de ingesta incluidas en el paquete. El instalador selecciona una
# o ambas; se puede ajustar manualmente y reiniciar el servidor.
# Valores válidos: sundial, zkteco, o sundial,zkteco.
SRTIME_ENABLED_ADDONS=sundial,zkteco

# PostgreSQL (fill only in config/.env local).
DB_ENGINE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=__SET_DATABASE_PASSWORD__
DB_NAME=srtime_db

# Required secrets: generate unique values in config/.env.
SECRET_KEY=__GENERATE_UNIQUE_SECRET__
TERMINAL_CREDENTIAL_KEY=__GENERATE_FERNET_KEY__
MIN_PASSWORD_LENGTH=8
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
